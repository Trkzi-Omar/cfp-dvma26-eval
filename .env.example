# Copy this file to .env (make setup does it for you).
#
# The defaults run everything offline with a mock LLM: no API key, no network,
# reproducible output. You only need to change these to call a real provider.

# 1 = use the mock LLM (default). 0 = call a real provider (requires a key).
MOCK_MODE=1

# Only used when MOCK_MODE=0.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
